# Excel 数据分析助手环境变量配置

# Gemini API Key (必需)
# 请在 https://aistudio.google.com/app/apikey 获取
GEMINI_API_KEY=your_gemini_api_key_here

# 服务端口配置 (可选)
GEMINI_PORT=8000
BACKEND_PORT=5001
FRONTEND_PORT=3000

# 使用方法:
# 1. 复制此文件为 .env
# 2. 将 your_gemini_api_key_here 替换为您的真实 API Key
# 3. 或者直接在 server_gemini.py 中修改 API_KEY 变量
